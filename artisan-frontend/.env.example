# Frontend ARTISAN_CI
# Local : laissez vide pour utiliser localhost:8000 automatiquement.
REACT_APP_API_BASE_URL=
REACT_APP_WS_BASE_URL=
# Facultatif : URL d'un service de reverse-geocoding compatible configuré dans le hotfix GPS.
REACT_APP_REVERSE_GEOCODER_URL=

# Mapbox GL JS - jeton public (pk....). Ne jamais utiliser de secret token côté frontend.
REACT_APP_MAPBOX_TOKEN=
# Facultatif : style personnalisé publié depuis Mapbox Studio.
REACT_APP_MAPBOX_STYLE_URL=
